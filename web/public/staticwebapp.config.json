{
  "routes": [
    {
      "route": "/instructions.md",
      "allowedRoles": ["anonymous"],
      "headers": { "content-type": "text/markdown; charset=utf-8", "cache-control": "no-cache" }
    },
    {
      "route": "/update.md",
      "allowedRoles": ["anonymous"],
      "headers": { "content-type": "text/markdown; charset=utf-8", "cache-control": "no-cache" }
    },
    {
      "route": "/performance.md",
      "allowedRoles": ["anonymous"],
      "headers": { "content-type": "text/markdown; charset=utf-8", "cache-control": "no-cache" }
    },
    {
      "route": "/agentctl.js",
      "allowedRoles": ["anonymous"],
      "headers": { "content-type": "text/javascript; charset=utf-8", "cache-control": "no-cache" }
    },
    { "route": "/api/*", "allowedRoles": ["anonymous"] },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/instructions.md", "/update.md", "/performance.md", "/agentctl.js", "/assets/*", "/.auth/*", "/favicon.svg"]
  },
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer", "statusCode": 302 }
  },
  "mimeTypes": { ".md": "text/markdown; charset=utf-8" },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "same-origin",
    "X-Frame-Options": "DENY"
  },
  "platform": { "apiRuntime": "node:20" }
}
